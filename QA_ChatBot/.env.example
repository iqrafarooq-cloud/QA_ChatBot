# AI provider: groq | gemini | anthropic. Set the matching API key below.
QA_BRAIN_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the provider's default model, screenshot model and fallbacks (comma-separated).
QA_BRAIN_MODEL=
QA_BRAIN_VISION_MODEL=
QA_BRAIN_FALLBACK_MODELS=

# Optional: reasoning effort (low | medium | high).
QA_BRAIN_EFFORT=

# Optional: how much attachment text and chat history go into each request (characters).
QA_BRAIN_CONTEXT_CHARS=
QA_BRAIN_HISTORY_CHARS=

# Optional (Anthropic only): server-side refusal fallback (beta). Set to false if your account rejects it.
QA_BRAIN_REFUSAL_FALLBACK=true

# Optional: where the database and uploaded files are stored (default ./data).
QA_BRAIN_DATA_DIR=

# Optional: upload size limit in MB (default 20).
QA_BRAIN_MAX_UPLOAD_MB=20

# Optional: per-IP request limits per minute.
QA_BRAIN_CHAT_RATE_PER_MIN=20
QA_BRAIN_UPLOAD_RATE_PER_MIN=40
